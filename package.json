{
  "name": "coaching-app",
  "version": "0.0.1",
  "description": "Junior football coaching app with match management and fairness tracking",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios:beta": "APP_VARIANT=beta expo prebuild --platform ios --clean && APP_VARIANT=beta expo run:ios",
    "android:beta": "APP_VARIANT=beta expo prebuild --platform android --clean && APP_VARIANT=beta expo run:android",
    "apk": "expo prebuild --platform android --clean && ./android/gradlew -p android assembleDebug",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "bundle:check": "expo export --platform android --output-dir .expo-bundle-check",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint ."
  },
  "keywords": [
    "coaching",
    "football",
    "match-management",
    "fairness-tracking"
  ],
  "author": "Rob van Stone",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~57.0.23",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-sharing": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
